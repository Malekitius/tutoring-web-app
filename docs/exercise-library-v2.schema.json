{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Malekitius/tutoring-web-app/blob/main/docs/exercise-library-v2.schema.json",
  "title": "Tutor exercise library v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "exercises"],
  "properties": {
    "format": {"const": "tutoring-web-app.exercise-library"},
    "version": {"const": 2},
    "exercises": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/exercise"}
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "prompt", "answer", "subject", "grades", "topic", "subtopic", "difficulty"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 10000},
        "answer": {"type": "string", "maxLength": 10000},
        "subject": {"type": "string", "minLength": 1, "maxLength": 80},
        "grades": {
          "type": "array", "minItems": 1, "maxItems": 11, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 11}
        },
        "topic": {"type": "string", "maxLength": 160},
        "subtopic": {"type": "string", "maxLength": 160},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    }
  }
}
